# Copy this file to .env for local development.
# .env is git-ignored. Never commit real keys.
#
# On Netlify, set the same variable under:
#   Site configuration > Environment variables
#
# Do NOT prefix it with VITE_ - that would expose it in the browser bundle.

# Shared access key. Anyone with the site link AND this key can view, edit and
# sync orders, so treat it like a password and rotate it if it spreads too far.
WSH_KEY=change-me
